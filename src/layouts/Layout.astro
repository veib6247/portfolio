---
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '@fontsource-variable/archivo';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const { title, description } = Astro.props;
const configuredSite = import.meta.env.PUBLIC_SITE_URL ?? Astro.site?.toString();
const canonicalUrl = configuredSite
	? new URL(Astro.url.pathname, configuredSite).toString()
	: undefined;
const socialImage = configuredSite ? new URL('/og-card.png', configuredSite).toString() : undefined;

const personJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	name: 'Bryan Olandres',
	jobTitle: 'Interim Senior Technology Lead',
	description,
	email: 'mailto:bryan.olandres.6247@gmail.com',
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Pasig City',
		addressCountry: 'PH',
	},
	sameAs: ['https://github.com/veib6247'],
	...(configuredSite ? { url: configuredSite } : {}),
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f4f7f8" />
		<meta name="color-scheme" content="light" />
		<meta name="description" content={description} />
		<meta name="author" content="Bryan Olandres" />
		<meta name="robots" content="index, follow" />
		<meta property="og:type" content="profile" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Bryan Olandres" />
		<meta property="og:locale" content="en_PH" />
		<meta property="profile:first_name" content="Bryan" />
		<meta property="profile:last_name" content="Olandres" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		{socialImage && <meta property="og:image" content={socialImage} />}
		{socialImage && <meta property="og:image:width" content="1200" />}
		{socialImage && <meta property="og:image:height" content="630" />}
		{socialImage && <meta property="og:image:alt" content="Bryan Olandres, Interim Senior Technology Lead" />}
		{socialImage && <meta name="twitter:image" content={socialImage} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
		<script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
	</head>
	<body>
		<slot />
		<Analytics />
	</body>
</html>
