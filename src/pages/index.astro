---
import Layout from '../layouts/Layout.astro';
import {
	PROFILE_PAGE_TITLE,
	RESUME_PATH,
	capabilityGroups,
	certifications,
	earlierRoles,
	payretoRoles,
	publicProfile,
	selectedWork,
} from '../data/profile';

const title = PROFILE_PAGE_TITLE;
const description = publicProfile.description;
const downloadPath = RESUME_PATH;
---

<Layout {title} {description}>
	<a class="skip-link" href="#main-content">Skip to main content</a>

	<header class="site-header no-print">
		<div class="shell header-inner">
			<a class="brand" href="#top" aria-label="Bryan Olandres, back to top">
				<span class="brand-mark" aria-hidden="true">BO</span>
				<span class="brand-name">Bryan Olandres</span>
			</a>
			<nav aria-label="Primary navigation">
				<a class="nav-link" href="#profile" data-nav="profile">Profile</a>
				<a class="nav-link" href="#work" data-nav="work">Work</a>
				<a class="nav-link" href="#experience" data-nav="experience">Career</a>
				<a class="nav-link" href="#range" data-nav="range">Range</a>
				<a class="nav-link nav-download" href={downloadPath} download="Bryan-Olandres-Resume.pdf">
					Resume
					<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 1v9m0 0 4-4m-4 4L4 6M2 14h12" /></svg>
				</a>
			</nav>
		</div>
	</header>

	<main id="main-content">
		<section class="hero" id="top" aria-labelledby="hero-title">
			<div class="shell hero-grid">
				<div class="hero-copy" data-reveal>
					<p class="eyebrow">{publicProfile.jobTitle} · Pasig City, Philippines</p>
					<h1 id="hero-title">Bryan<br /><em>Olandres</em></h1>
					<p class="hero-statement">I translate product and operational needs into technical direction and lead delivery.</p>
					<p class="hero-summary">
						I work across fintech platforms, payment systems, internal tools, and artificial intelligence (AI) products.
						At Payreto, I partner with the Chief Executive Officer (CEO) on product discovery and serve as the primary Scrum Master across delivery initiatives.
					</p>
					<div class="hero-actions no-print">
						<a class="button primary" href="#work">
							View selected work
							<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M3 8h10m-4-4 4 4-4 4" /></svg>
						</a>
						<a class="button" href={downloadPath} download="Bryan-Olandres-Resume.pdf">
							Download resume
							<svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 1v9m0 0 4-4m-4 4L4 6M2 14h12" /></svg>
						</a>
					</div>
				</div>

				<aside class="hero-rail" aria-label="Professional overview" data-reveal>
					<div class="rail-status"><span></span> {publicProfile.jobTitle}</div>
					<dl>
						<div><dt>Experience</dt><dd>10+ years</dd></div>
						<div><dt>Current company</dt><dd>Payreto Services Inc.</dd></div>
						<div><dt>Primary domain</dt><dd>Fintech and payment systems</dd></div>
						<div><dt>Operating range</dt><dd>Discovery, architecture, delivery</dd></div>
						<div><dt>Email</dt><dd><a href="mailto:bryan.olandres.6247@gmail.com">bryan.olandres.6247@gmail.com</a></dd></div>
						<div><dt>GitHub</dt><dd><a href="https://github.com/veib6247" rel="me">github.com/veib6247</a></dd></div>
					</dl>
				</aside>
			</div>
			<div class="accountability-strip">
				<div class="shell">
					<span><strong>10+ years</strong> across technical operations and delivery</span>
					<span><strong>Fintech</strong> and payment systems</span>
					<span><strong>Operating range:</strong> discovery, architecture, and delivery</span>
				</div>
			</div>
		</section>

		<section class="section leadership" id="profile" aria-labelledby="profile-title">
			<div class="shell section-grid">
				<div class="section-rail" data-reveal>
					<p class="section-index">01 / Profile</p>
					<p class="rail-note">Current scope</p>
				</div>
				<div class="section-body">
					<div class="section-heading" data-reveal>
						<h2 id="profile-title">From technical direction <em>to delivery</em></h2>
						<p>I am a {publicProfile.jobTitle} based in Pasig City, Philippines. I translate business questions into system decisions and lead delivery across fintech platforms, payment systems, internal tools, and AI products.</p>
					</div>
					<div class="leadership-grid">
						<article data-reveal><span>01</span><h3>Product discovery</h3><p>I partner with executive leadership to shape problem statements, assess opportunities, and translate findings into technical priorities.</p></article>
						<article data-reveal><span>02</span><h3>Technical direction</h3><p>I guide architecture, integration choices, security practices, and delivery standards across payment and internal platforms.</p></article>
						<article data-reveal><span>03</span><h3>Delivery leadership</h3><p>I lead sprint planning, prioritization, risk management, and stakeholder alignment as the primary Scrum Master across projects.</p></article>
						<article data-reveal><span>04</span><h3>Team development</h3><p>I support cross-functional engineering teams through technical guidance, code review practices, and developer mentorship.</p></article>
					</div>
				</div>
			</div>
		</section>

		<section class="section selected-work" id="work" aria-labelledby="work-title">
			<div class="shell section-grid">
				<div class="section-rail" data-reveal>
					<p class="section-index">02 / Selected work</p>
					<p class="rail-note">Selected initiatives</p>
				</div>
				<div class="section-body">
					<div class="section-heading compact" data-reveal>
						<h2 id="work-title">Work that connects <em>systems and operations</em></h2>
						<p>A selection of internal products and technical initiatives from my work at Payreto.</p>
					</div>
					<div class="work-list">
						{selectedWork.map((item) => (
							<article class="work-item" data-reveal>
								<p class="meta">{item.code}</p>
								<h3>{item.title}</h3>
								<p>{item.description}</p>
								<p class="work-scope">{item.scope}</p>
							</article>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="section experience" id="experience" aria-labelledby="experience-title">
			<div class="shell section-grid">
				<div class="section-rail" data-reveal>
					<p class="section-index">03 / Experience</p>
					<p class="rail-note">2011 to present</p>
				</div>
				<div class="section-body">
					<div class="section-heading" data-reveal>
						<h2 id="experience-title">From payment operations <em>to technology leadership</em></h2>
						<p>At Payreto, I advanced from payment operations and client solutions into technology leadership. Each role expanded my responsibilities across architecture, products, teams, and delivery.</p>
					</div>

					<div class="company-heading" data-reveal>
						<div><p class="eyebrow">Payreto Services Inc.</p><h3>Four roles since 2019</h3></div>
						<p>Makati, Philippines</p>
					</div>
					<ol class="timeline">
						{payretoRoles.map((role) => (
							<li data-reveal>
								<time>{role.period}</time>
								<div><h3>{role.title}</h3><p>{role.copy}</p></div>
							</li>
						))}
					</ol>

					<div class="earlier-heading" data-reveal><p class="eyebrow">Earlier experience</p><h3>Technical foundations</h3></div>
					<div class="earlier-roles">
						{earlierRoles.map((role) => (
							<article data-reveal>
								<time>{role.period}</time>
								<h3>{role.role}</h3>
								<p class="company">{role.company}</p>
								<p>{role.copy}</p>
							</article>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="section capability" id="range" aria-labelledby="range-title">
			<div class="shell section-grid">
				<div class="section-rail" data-reveal>
					<p class="section-index">04 / Technical range</p>
					<p class="rail-note">Leadership backed by practice</p>
				</div>
				<div class="section-body">
					<div class="section-heading compact" data-reveal>
						<h2 id="range-title">Broad enough to lead. <em>Close enough to review.</em></h2>
						<p>My technical background supports architecture decisions, delivery planning, code review, vendor discussions, and production operations.</p>
					</div>
					<div class="capability-list">
						{capabilityGroups.map((group, index) => (
							<div class="capability-row" data-reveal>
								<p class="meta">0{index + 1}</p>
								<h3>{group.label}</h3>
								<ul>{group.items.map((item) => <li>{item}</li>)}</ul>
							</div>
						))}
					</div>
				</div>
			</div>
		</section>

		<section class="section credentials" aria-labelledby="credentials-title">
			<div class="shell section-grid">
				<div class="section-rail" data-reveal>
					<p class="section-index">05 / Education</p>
					<p class="rail-note">Formal and continued learning</p>
				</div>
				<div class="section-body credentials-grid">
					<div class="education-block" data-reveal>
						<p class="eyebrow">Education</p>
						<h2 id="credentials-title">Bachelor of Science<br /><em>in Computer Science</em></h2>
						<p>Bohol Island State University · 2013</p>
					</div>
					<div class="certification-list" data-reveal>
						<p class="eyebrow">Certifications</p>
						<ul>
							{certifications.map(([year, credential, provider]) => (
								<li><time>{year}</time><span>{credential}</span><small>{provider}</small></li>
							))}
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section class="contact" id="contact" aria-labelledby="contact-title">
			<div class="shell contact-grid">
				<div data-reveal>
					<p class="section-index">06 / Contact</p>
					<h2 id="contact-title">Let's discuss<br /><em>the work.</em></h2>
				</div>
				<div class="contact-copy" data-reveal>
					<p>Email me to discuss technology leadership, fintech platforms, payment systems, product delivery, or other complex technical projects.</p>
					<div class="contact-actions no-print">
						<a class="button primary" href="mailto:bryan.olandres.6247@gmail.com">Email Bryan <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M3 8h10m-4-4 4 4-4 4" /></svg></a>
						<a class="button" href={downloadPath} download="Bryan-Olandres-Resume.pdf">Download resume <svg aria-hidden="true" viewBox="0 0 16 16"><path d="M8 1v9m0 0 4-4m-4 4L4 6M2 14h12" /></svg></a>
					</div>
					<address>
						<a href="mailto:bryan.olandres.6247@gmail.com">bryan.olandres.6247@gmail.com</a>
						<a href="https://github.com/veib6247" rel="me">github.com/veib6247</a>
						<span>Pasig City, Philippines</span>
					</address>
				</div>
			</div>
		</section>
	</main>

	<footer>
		<div class="shell footer-inner">
			<p>Bryan Olandres · {publicProfile.jobTitle}</p>
			<a class="no-print" href="#top">Back to top ↑</a>
		</div>
	</footer>

	<script>
		const revealItems = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'))
			.filter((item) => !item.querySelector('a, button, input, select, textarea'));
		if ('IntersectionObserver' in window) {
			revealItems.forEach((item) => item.classList.add('reveal-ready'));
			document.documentElement.classList.add('has-reveal');
			const revealObserver = new IntersectionObserver(
				(entries, observer) => {
					for (const entry of entries) {
						if (entry.isIntersecting) {
							entry.target.classList.add('is-visible');
							observer.unobserve(entry.target);
						}
					}
				},
				{ rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
			);
			revealItems.forEach((item) => revealObserver.observe(item));
		}

		const sections = document.querySelectorAll<HTMLElement>('section[id]');
		const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-nav]');
		if ('IntersectionObserver' in window && navLinks.length) {
			const sectionObserver = new IntersectionObserver(
				(entries) => {
					const visible = entries
						.filter((entry) => entry.isIntersecting)
						.sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
					if (!visible) return;
					navLinks.forEach((link) => {
						const active = link.dataset.nav === visible.target.id;
						link.classList.toggle('is-active', active);
						if (active) link.setAttribute('aria-current', 'location');
						else link.removeAttribute('aria-current');
					});
				},
				{ rootMargin: '-30% 0px -60% 0px', threshold: [0, 0.1, 0.25] },
			);
			sections.forEach((section) => sectionObserver.observe(section));
		}
	</script>
</Layout>

<style>
	@layer legacy {
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid color-mix(in srgb, var(--line), transparent 20%);
		background: color-mix(in srgb, var(--paper), transparent 7%);
		backdrop-filter: blur(14px);
	}

	.header-inner {
		display: flex;
		min-height: 72px;
		align-items: stretch;
		justify-content: space-between;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 12px;
		font-size: 0.86rem;
		font-weight: 750;
		text-decoration: none;
	}

	.brand-mark {
		display: grid;
		width: 34px;
		height: 34px;
		place-items: center;
		background: var(--ink);
		color: var(--paper);
		font-family: var(--mono);
		font-size: 0.7rem;
		letter-spacing: 0.06em;
	}

	nav {
		display: flex;
		align-items: stretch;
	}

	.nav-link {
		display: flex;
		min-width: 88px;
		align-items: center;
		justify-content: center;
		border-left: 1px solid var(--line);
		text-decoration: none;
		transition: background 160ms ease, color 160ms ease;
	}

	.nav-link:hover,
	.nav-link.is-active {
		background: var(--ink);
		color: var(--paper);
	}

	.nav-download {
		gap: 8px;
		padding-inline: 18px;
		background: var(--signal);
		color: var(--white);
	}

	.nav-download svg,
	.hero-actions svg,
	.contact-actions svg {
		width: 16px;
		fill: none;
		stroke: currentColor;
		stroke-linecap: square;
		stroke-width: 1.6;
	}

	.hero {
		position: relative;
		padding: clamp(72px, 10vw, 150px) 0 0;
		overflow: hidden;
	}

	.hero::before {
		position: absolute;
		top: 0;
		right: 0;
		width: min(34vw, 460px);
		height: 100%;
		border-left: 1px solid var(--line);
		background: linear-gradient(145deg, rgba(21, 94, 239, 0.1), transparent 58%);
		content: '';
		pointer-events: none;
	}

	.hero-grid {
		position: relative;
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(260px, 0.38fr);
		gap: clamp(54px, 8vw, 118px);
	}

	.hero-copy {
		padding-bottom: clamp(76px, 9vw, 136px);
	}

	.hero h1 {
		max-width: 860px;
		margin: 24px 0 28px;
		font-family: var(--display);
		font-size: clamp(5rem, 10.5vw, 9.5rem);
		font-weight: 520;
		letter-spacing: -0.07em;
		line-height: 0.72;
	}

	.hero h1 em,
	.section-heading em,
	.education-block em,
	.contact em {
		color: var(--signal);
		font-weight: 430;
	}

	.hero-statement {
		max-width: 800px;
		margin-bottom: 24px;
		font-family: var(--display);
		font-size: clamp(1.7rem, 3.2vw, 3rem);
		font-weight: 470;
		letter-spacing: -0.025em;
		line-height: 1.08;
	}

	.hero-summary {
		max-width: 720px;
		margin-bottom: 36px;
		color: var(--muted);
		font-size: clamp(1rem, 1.3vw, 1.15rem);
		line-height: 1.7;
	}

	.hero-actions,
	.contact-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.hero-rail {
		position: relative;
		align-self: end;
		padding: 30px 0 34px 30px;
		border-left: 1px solid var(--ink);
	}

	.rail-status {
		display: flex;
		align-items: center;
		gap: 10px;
		margin-bottom: 30px;
		font-family: var(--mono);
		font-size: 0.69rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.rail-status span {
		width: 8px;
		height: 8px;
		background: var(--signal);
		box-shadow: 0 0 0 4px rgba(21, 94, 239, 0.14);
	}

	.hero-rail dl,
	.hero-rail dd {
		margin: 0;
	}

	.hero-rail dl > div {
		padding: 14px 0;
		border-top: 1px solid var(--line);
	}

	.hero-rail dt {
		margin-bottom: 4px;
		color: var(--muted);
		font-family: var(--mono);
		font-size: 0.64rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.hero-rail dd {
		font-size: 0.91rem;
		font-weight: 650;
		line-height: 1.35;
		overflow-wrap: anywhere;
	}

	.route-line {
		display: grid;
		width: 100%;
		height: 34px;
		grid-template-columns: auto 1fr auto 1fr auto;
		align-items: center;
		background: var(--ink);
	}

	.route-line span {
		width: 9px;
		height: 9px;
		margin-inline: 14px;
		border: 2px solid var(--paper);
	}

	.route-line span:nth-of-type(2) {
		border-color: var(--signal);
		background: var(--signal);
	}

	.route-line i {
		height: 1px;
		background: repeating-linear-gradient(90deg, #8c877d 0 6px, transparent 6px 11px);
	}

	.section {
		padding: clamp(90px, 11vw, 160px) 0;
		border-bottom: 1px solid var(--line);
	}

	.section-grid {
		display: grid;
		grid-template-columns: 180px minmax(0, 1fr);
		gap: clamp(38px, 6vw, 88px);
	}

	.section-rail {
		position: relative;
		padding-right: 28px;
		border-right: 1px solid var(--line);
	}

	.rail-note {
		position: sticky;
		top: 105px;
		margin-top: 28px;
		color: var(--muted);
		font-size: 0.78rem;
		line-height: 1.45;
	}

	.section-heading {
		display: grid;
		grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
		gap: 48px;
		align-items: end;
		margin-bottom: 72px;
	}

	.section-heading.compact {
		margin-bottom: 54px;
	}

	.section-heading h2,
	.education-block h2,
	.contact h2 {
		margin: 0;
		font-family: var(--display);
		font-size: clamp(3rem, 5.4vw, 5.3rem);
		font-weight: 480;
		letter-spacing: -0.045em;
		line-height: 0.96;
	}

	.section-heading p {
		margin: 0;
		color: var(--muted);
		font-size: 1rem;
		line-height: 1.75;
	}

	.leadership-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		border-top: 1px solid var(--ink);
		border-left: 1px solid var(--line);
	}

	.leadership-grid article {
		min-height: 240px;
		padding: 28px;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}

	.leadership-grid article > span {
		color: var(--signal-dark);
		font-family: var(--mono);
		font-size: 0.7rem;
	}

	.leadership-grid h3,
	.work-item h3,
	.company-heading h3,
	.timeline h3,
	.earlier-heading h3,
	.earlier-roles h3,
	.capability-row h3 {
		font-family: var(--display);
		font-weight: 560;
		letter-spacing: -0.018em;
	}

	.leadership-grid h3 {
		margin: 42px 0 14px;
		font-size: 1.65rem;
	}

	.leadership-grid p,
	.work-item > p:not(.meta, .work-scope),
	.timeline p,
	.earlier-roles > article > p:last-child {
		margin-bottom: 0;
		color: var(--muted);
		line-height: 1.7;
	}

	.selected-work {
		background: var(--ink);
		color: var(--paper);
	}

	.selected-work .section-rail {
		border-color: #3d3b35;
	}

	.selected-work .section-index,
	.selected-work .meta {
		color: var(--safety);
	}

	.selected-work .rail-note,
	.selected-work .section-heading p,
	.selected-work .work-item > p:not(.meta, .work-scope) {
		color: #bdb8ad;
	}

	.selected-work .section-heading em {
		color: var(--safety);
	}

	.work-list {
		border-top: 1px solid #68645b;
	}

	.work-item {
		display: grid;
		grid-template-columns: 160px minmax(210px, 0.65fr) minmax(300px, 1fr);
		gap: 28px;
		padding: 36px 0;
		border-bottom: 1px solid #45423b;
	}

	.work-item h3 {
		margin: 0;
		font-size: clamp(1.55rem, 2.4vw, 2.25rem);
		line-height: 1.05;
	}

	.work-scope {
		grid-column: 2 / -1;
		margin: 2px 0 0;
		color: #88847a;
		font-family: var(--mono);
		font-size: 0.67rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.company-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		padding: 28px 0;
		border-top: 2px solid var(--ink);
		border-bottom: 1px solid var(--line);
	}

	.company-heading h3,
	.earlier-heading h3 {
		margin: 3px 0 0;
		font-size: 2rem;
	}

	.company-heading > p {
		margin: 0;
		color: var(--muted);
		font-size: 0.86rem;
	}

	.timeline {
		margin: 0 0 90px;
		padding: 0;
		list-style: none;
	}

	.timeline li {
		position: relative;
		display: grid;
